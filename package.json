{
  "name": "polarist-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:backend": "cd backend-rust && cargo run",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "sync-api": "node scripts/sync-api.js",
    "sync-api:check": "node scripts/sync-api.js --check",
    "sync-api:status": "node scripts/sync-api.js --status",
    "validate-api-sync": "node scripts/validate-api-sync.js",
    "docs": "echo 'API docs available at http://localhost:4000/api/docs'",
    "validate-types": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:api-client": "jest __tests__/api-client.test.ts",
    "test:sync-system": "jest __tests__/sync-api.test.ts",
    "test:integration": "jest __tests__/integration --testTimeout=60000",
    "test:backend": "cd backend-rust && cargo test",
    "test:backend:sqlite": "cd backend-rust && TEST_DB_TYPE=sqlite cargo test",
    "test:backend:postgres": "cd backend-rust && TEST_DB_TYPE=postgres cargo test integration_postgres_tests",
    "test:all": "npm run test:backend && npm run test",
    "test:all:postgres": "npm run test:backend:postgres && npm run test",
    "db:setup": "docker compose up -d postgres-dev",
    "db:setup:prod": "docker compose -f docker-compose.prod.yml up -d postgres-prod",
    "db:setup:test": "docker compose -f docker-compose.test.yml up -d postgres-test",
    "db:stop": "docker compose down",
    "db:stop:prod": "docker compose -f docker-compose.prod.yml down",
    "db:stop:test": "docker compose -f docker-compose.test.yml down",
    "db:migrate": "cd backend-rust && NODE_ENV=development cargo run -- --migrate",
    "db:migrate:prod": "cd backend-rust && NODE_ENV=production cargo run -- --migrate",
    "db:migrate:test": "cd backend-rust && NODE_ENV=test cargo run -- --migrate",
    "db:reset": "npm run db:stop && docker volume rm polarist-nextjs_postgres_dev_data || true && npm run db:setup && sleep 5 && npm run db:migrate",
    "db:reset:test": "npm run db:stop:test && docker volume rm polarist-nextjs_postgres_test_data || true && npm run db:setup:test && sleep 5 && npm run db:migrate:test",
    "db:logs": "docker compose logs -f postgres-dev",
    "db:shell": "docker compose exec postgres-dev psql -U polarist_dev -d polarist_dev"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^15.4.4",
    "@types/mdx": "^2.0.13",
    "axios": "^1.11.0",
    "cheerio": "^1.1.2",
    "joi": "^17.13.3",
    "next": "15.4.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/cheerio": "^0.22.35",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.4.2",
    "openapi-typescript": "^7.4.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5",
    "@testing-library/react": "^16.1.0",
    "@testing-library/jest-dom": "^6.8.1",
    "@testing-library/user-event": "^14.5.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "msw": "^2.8.4",
    "@types/jest": "^29.5.14"
  }
}
